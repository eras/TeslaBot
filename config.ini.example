[common]
state_file = state.ini
control = matrix
# Comma-separated unique lowercase names; e.g. matrix,slack,mqtt.
# Whitespace is trimmed; empty/duplicate/unknown components fail startup.

[tesla]
email = user@example.com

# To constrain the list of available devices in the bot:
# override_vehicles = vehicle1,vehicle2

[matrix]
# Store matrix state in this directory
store_path = matrix_store

# Homeserver to use
homeserver = https://matrix.org/

# Matrix id for the bot
mxid = @yourtesla:matrix.org

# Password for logging in to Matrix; can be removed after initial signin is complete
# and access token is written to state_file
password = secret_password

# Trust the devices of these users. Not secure against active attacks.
trust_mxids = @youruserid:matrix.org,@anotherid:example.com

# Separate positive finite timeouts in seconds. Readiness does not consume the
# encrypted delivery budget (key claims/sharing and HTTP sends included).
readiness_timeout = 120
send_timeout = 120

[slack]
slack_api_secret_id =     <slack api key>
slack_app_secret_id =     <slack app key>
# Channel from which you can authorize and logout
slack_admin_channel_id =  <admin channel id from slack>
# Normal command/reply channel; admin replies use slack_admin_channel_id only.
channel = #teslacontrol

# Add MQTT alongside chat with common.control = matrix,mqtt (or slack,mqtt).
# Standalone mqtt requires cached Tesla auth and leaves saved timers untouched.
# Use a unique prefix per instance and retain state.ini for discovery cleanup.
[mqtt]
host = localhost
port = 1883
# username = teslabot
# password = secret
tls = false
prefix = teslabot
discovery_prefix = homeassistant
# One-shot settling delay after successful MQTT AC/sauna/charge-limit actions.
# Integer seconds 0..300; 0 keeps the legacy immediate result-then-read mode.
# A saved HA/MQTT setting overrides this bootstrap value on restart.
action_refresh_delay = 5
